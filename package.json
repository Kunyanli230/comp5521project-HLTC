{
  "name": "comp5521-cross-chain-htlc",
  "version": "1.0.0",
  "description": "COMP5521 Rain / ETH exchange on Ethereum Sepolia and Arbitrum Sepolia",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "secret": "hardhat run scripts/generateSecret.js",
    "config:check": "node scripts/checkConfig.js",
    "server": "node scripts/serveFrontend.mjs",
    "deploy": "hardhat run scripts/deploy.js",
    "swap:success": "hardhat run scripts/successfulSwap.js",
    "status": "node scripts/status.js",
    "refund": "node scripts/refund.js",
    "lock:only": "node scripts/lockOnly.js",
    "test:refund-path": "hardhat compile && node test/integration/refundPath.js",
    "test:web": "hardhat compile && node test/integration/webCoordinator.mjs",
    "abi:export": "hardhat run scripts/exportAbi.js",
    "test:cross-chain": "hardhat compile && node test/integration/crossChain.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.13",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "chai": "^4.5.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.16"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "cbor": "8.1.0",
    "dotenv": "^17.2.2"
  }
}
