# RPC URLs can contain API keys. Keep .env private.
SEPOLIA_RPC_URL="https://YOUR_SEPOLIA_RPC"
ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"

# Both accounts need gas on both chains. Alice owns Rain; Bob supplies ETH.
ALICE_PRIVATE_KEY=""
BOB_PRIVATE_KEY=""
ALICE_ADDRESS=""
BOB_ADDRESS=""

RAIN_ADDRESS=""

# Optional before deployment; public deployment records also supply addresses.
SEPOLIA_ERC20_HTLC_ADDRESS=""
ARBITRUM_SEPOLIA_ETH_HTLC_ADDRESS=""

RAIN_AMOUNT="100"
ETH_AMOUNT="0.001"
RAIN_TIMELOCK_SECONDS="7200"
ETH_TIMELOCK_SECONDS="3600"
MIN_TIMELOCK_GAP_SECONDS="600"
MIN_CLAIM_WINDOW_SECONDS="120"
SEPOLIA_CONFIRMATIONS="2"
ARBITRUM_SEPOLIA_CONFIRMATIONS="2"
TX_TIMEOUT_MS="300000"

# Optional: used only for contract source verification
ETHERSCAN_API_KEY=""
